# openapi-typescript (pinned as a devDependency for the reproducible contract-drift
# gate) declares a `typescript@^5.x` peer, but this app runs typescript 6.x. The
# generated types are verified byte-identical against the committed src/types/api.gen.ts
# in CI, so relax the peer check here rather than downgrade the app's TypeScript.
legacy-peer-deps=true
