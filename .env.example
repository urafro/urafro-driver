# urAfro Driver — environment template. Copy to .env.local and fill in.
#
# THIS REPO IS PUBLIC. Never put a real secret in any of these: Expo INLINES every
# EXPO_PUBLIC_* value into the built JS bundle, so anything here ships to every device
# and can be read out of the APK. Only public configuration belongs in this file.
#
# All of these are baked in AT BUILD TIME. Changing one requires a new EAS build —
# which is also why the /v1 contract must stay backward-compatible (expand/contract):
# a shipped build cannot be force-updated.

# Platform base URL. Defaults to production when unset (src/config.ts).
# Point it at a local NestJS instance for development.
EXPO_PUBLIC_API_BASE=https://urafro-next.fly.dev

# Ops support line for the in-app "Contact support" button (E.164, e.g. +2637...).
# The button HIDES when this is unset — which is the current state of shipped builds,
# because eas.json defines no env for any profile. Set it in the EAS build profile to
# turn the button on.
EXPO_PUBLIC_OPS_WHATSAPP=

# Epic C realtime (SSE over /v1/driver/stream). An ACCELERATOR only — push + polling
# remain the floor, so leaving this off costs latency, never correctness.
# Still off in production: turning it on needs BOTH this (a new EAS build) and
# REALTIME_ENABLED on the platform.
EXPO_PUBLIC_REALTIME_ENABLED=false

# In-app feedback channels. Both default to ON; set to "false" to mute for QA or on
# very low-end devices. A driver-facing mute also exists in settings at runtime.
EXPO_PUBLIC_SOUND_ENABLED=true
EXPO_PUBLIC_HAPTICS_ENABLED=true

# ── EAS build-time only (NOT EXPO_PUBLIC_, never inlined into the bundle) ──────
# Path to the Firebase config that enables FCM push. Supplied as an EAS "file"
# secret, not committed. app.config.js falls back to ./google-services.json locally.
# GOOGLE_SERVICES_JSON=
