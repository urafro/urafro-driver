{
  "expo": {
    "name": "urafro-driver",
    "slug": "urafro-driver",
    "owner": "urafro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.urafro.driver",
      "supportsTablet": true
    },
    "android": {
      "package": "com.urafro.driver",
      "adaptiveIcon": {
        "backgroundColor": "#432344",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.CAMERA"
      ]
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#f9f9f9"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Lato",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Lato-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Lato-Bold.ttf", "weight": 700 }
                ]
              }
            ]
          },
          "ios": {
            "fonts": ["./assets/fonts/Lato-Regular.ttf", "./assets/fonts/Lato-Bold.ttf"]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#432344"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "urAfro Driver uses your location to show nearby delivery offers and share your position during a delivery.",
          "locationAlwaysAndWhenInUsePermission": "urAfro Driver shares your location while you're on shift — even in the background — so you can keep receiving and running deliveries.",
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "urAfro Driver accesses your photos so you can upload your ID and verification documents.",
          "cameraPermission": "urAfro Driver uses your camera to take a delivery photo as proof of delivery."
        }
      ],
      "@sentry/react-native/expo"
    ],
    "extra": {
      "eas": {
        "projectId": "6844131e-18b2-4ada-bdab-f946f2a15bc4"
      }
    }
  }
}
